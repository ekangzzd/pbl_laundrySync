-- INITIAL PAYMENT INSERT (IF NO ADDITIONAL PAYMENT)
INSERT INTO payment_tbl (order_id, pickup_datetime, payment_method, total_price, additional_price, total_payment, updated_details_id)
SELECT
    o.order_id,
    '2025-02-25 10:00:00' AS pickup_datetime,  -- Example datetime
    'cash' AS payment_method,
    (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) AS total_price,
    0.00 AS additional_price,  -- No additional price at first
    (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) AS total_payment, -- Initially the same as total_price
    NULL AS updated_details_id  -- No update yet
FROM laundryOrder_tbl o
JOIN laundryDetails_tbl ld1 ON o.details_id = ld1.details_id
LEFT JOIN washLoad_tbl w1 ON ld1.washLoad_id = w1.washLoad_id
LEFT JOIN dryLoad_tbl d1 ON ld1.dryLoad_id = d1.dryLoad_id
WHERE o.order_id = 1;  -- Only for the first order

-- Updating updated_details_id When the Order is Modified
UPDATE payment_tbl
SET updated_details_id = 5  -- Example new details_id
WHERE order_id = 1;

-- Recalculating total_payment After Update
UPDATE payment_tbl p
JOIN laundryOrder_tbl o ON p.order_id = o.order_id
JOIN laundryDetails_tbl ld1 ON o.details_id = ld1.details_id -- Original details
LEFT JOIN washLoad_tbl w1 ON ld1.washLoad_id = w1.washLoad_id
LEFT JOIN dryLoad_tbl d1 ON ld1.dryLoad_id = d1.dryLoad_id
LEFT JOIN laundryDetails_tbl ld2 ON p.updated_details_id = ld2.details_id -- New details
LEFT JOIN washLoad_tbl w2 ON ld2.washLoad_id = w2.washLoad_id
LEFT JOIN dryLoad_tbl d2 ON ld2.dryLoad_id = d2.dryLoad_id
SET
    p.total_price = COALESCE(w1.price, 0) + COALESCE(d1.price, 0),
    p.additional_price = GREATEST(0, (COALESCE(w2.price, 0) + COALESCE(d2.price, 0)) - (COALESCE(w1.price, 0) + COALESCE(d1.price, 0))),
    p.total_payment = (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) +
                      GREATEST(0, (COALESCE(w2.price, 0) + COALESCE(d2.price, 0)) - (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)))
WHERE p.order_id = 1;
