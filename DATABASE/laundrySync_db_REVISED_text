-- Customer Table
CREATE TABLE customer_tbl (
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    fName VARCHAR(100) NOT NULL,
    mName VARCHAR(100) NULL,
    lName VARCHAR(100) NOT NULL,
    suffix ENUM('Jr.', 'Sr.', 'II', 'III', 'IV') NULL,
    unit VARCHAR(50),
    street VARCHAR(100) NOT NULL,
    barangay VARCHAR(100) NOT NULL,
    city VARCHAR(100) NOT NULL,
    region VARCHAR(100) NOT NULL,
    country VARCHAR(100) NOT NULL,
    zipcode VARCHAR(10) NOT NULL,
    contactEmail VARCHAR(100) NOT NULL UNIQUE,
    contactNumber VARCHAR(20) NOT NULL
);

-- Login Table
CREATE TABLE login_tbl (
    login_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    contactEmail VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    FOREIGN KEY (customer_id) REFERENCES customer_tbl(customer_id) ON DELETE CASCADE
);

-- Notifications Table
CREATE TABLE notifications_tbl (
    notification_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    message TEXT NOT NULL,
    status ENUM('unread', 'read') DEFAULT 'unread',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (customer_id) REFERENCES customer_tbl(customer_id) ON DELETE CASCADE
);

-- Laundry Order Status Table
CREATE TABLE laundryOrderStatus_tbl (
    status_id INT PRIMARY KEY AUTO_INCREMENT,
    status_name VARCHAR(50) NOT NULL
);

-- Laundry Service Table
CREATE TABLE laundryService_tbl (
    service_id INT PRIMARY KEY AUTO_INCREMENT,
    service_name VARCHAR(100) NOT NULL,
    service_desc TEXT
);

-- Wash Load Table
CREATE TABLE washLoad_tbl (
    washLoad_id INT PRIMARY KEY AUTO_INCREMENT,
    size ENUM('small', 'medium', 'large') NOT NULL,
    intensity ENUM('light', 'medium', 'heavy') NOT NULL,
    description VARCHAR(255) NOT NULL,
    price FLOAT NOT NULL
);

-- Dry Load Table
CREATE TABLE dryLoad_tbl (
    dryLoad_id INT PRIMARY KEY AUTO_INCREMENT,
    size ENUM('medium', 'large') NOT NULL,
    description VARCHAR(255) NOT NULL,
    price FLOAT NOT NULL
);

-- Laundry Details Table
CREATE TABLE laundryDetails_tbl (
    details_id INT PRIMARY KEY AUTO_INCREMENT,
    service_id INT NOT NULL,
    washLoad_id INT NULL,
    dryLoad_id INT NULL,
    FOREIGN KEY (service_id) REFERENCES laundryService_tbl(service_id) ON DELETE CASCADE,
    FOREIGN KEY (washLoad_id) REFERENCES washLoad_tbl(washLoad_id) ON DELETE CASCADE,
    FOREIGN KEY (dryLoad_id) REFERENCES dryLoad_tbl(dryLoad_id) ON DELETE CASCADE
);

-- Laundry Order Table
CREATE TABLE laundryOrder_tbl (
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    details_id INT NOT NULL,
    status_id INT NOT NULL,
    orderDate DATE NOT NULL,
    FOREIGN KEY (customer_id) REFERENCES customer_tbl(customer_id) ON DELETE CASCADE,
    FOREIGN KEY (details_id) REFERENCES laundryDetails_tbl(details_id) ON DELETE CASCADE,
    FOREIGN KEY (status_id) REFERENCES laundryOrderStatus_tbl(status_id) ON DELETE CASCADE
);

-- Payment Table:
CREATE TABLE payment_tbl (
    payment_id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL,
    pickup_datetime DATETIME NOT NULL,
    payment_method ENUM('cash', 'credit', 'debit', 'online') NOT NULL,
    total_price DECIMAL(10,2) NOT NULL DEFAULT 0.00, 
    updated_details_id INT DEFAULT NULL,
    additional_price DECIMAL(10,2) NOT NULL DEFAULT 0.00, 
    total_payment DECIMAL(10,2) NOT NULL DEFAULT 0.00, 
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (order_id) REFERENCES laundryOrder_tbl(order_id) ON DELETE CASCADE,
    FOREIGN KEY (updated_details_id) REFERENCES laundryDetails_tbl(details_id) ON DELETE SET NULL
);

