-- INITIAL PAYMENT INSERT (IF NO ADDITIONAL PAYMENT)
INSERT INTO payment_tbl (order_id, pickupDatetime, paymentMethod, totalPrice, additionalPrice, totalPayment, updatedDetails_id)
SELECT
    o.order_id,
    '2025-02-25 10:00:00' AS pickupDatetime,  -- Corrected column name
    'cash' AS paymentMethod,  -- Corrected column name
    (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) AS totalPrice,  -- Corrected column name
    0.00 AS additionalPrice,  -- Corrected column name
    (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) AS totalPayment,  -- Corrected column name
    NULL AS updatedDetails_id  -- No update yet
FROM laundryOrder_tbl o
JOIN laundryDetails_tbl ld1 ON o.details_id = ld1.details_id
LEFT JOIN washLoad_tbl w1 ON ld1.washLoad_id = w1.washLoad_id
LEFT JOIN dryLoad_tbl d1 ON ld1.dryLoad_id = d1.dryLoad_id
WHERE o.order_id = 1;  -- Only for the first order

-- Updating updatedDetails_id When the Order is Modified
UPDATE payment_tbl
SET updatedDetails_id = 5  -- Example new details_id
WHERE order_id = 1;

-- Recalculating totalPayment After Update
UPDATE payment_tbl p
JOIN laundryOrder_tbl o ON p.order_id = o.order_id
JOIN laundryDetails_tbl ld1 ON o.details_id = ld1.details_id -- Original details
LEFT JOIN washLoad_tbl w1 ON ld1.washLoad_id = w1.washLoad_id
LEFT JOIN dryLoad_tbl d1 ON ld1.dryLoad_id = d1.dryLoad_id
LEFT JOIN laundryDetails_tbl ld2 ON p.updatedDetails_id = ld2.details_id -- New details
LEFT JOIN washLoad_tbl w2 ON ld2.washLoad_id = w2.washLoad_id
LEFT JOIN dryLoad_tbl d2 ON ld2.dryLoad_id = d2.dryLoad_id
SET
    p.totalPrice = COALESCE(w1.price, 0) + COALESCE(d1.price, 0),  -- Corrected column name
    p.additionalPrice = GREATEST(0, (COALESCE(w2.price, 0) + COALESCE(d2.price, 0)) - (COALESCE(w1.price, 0) + COALESCE(d1.price, 0))),  -- Corrected column name
    p.totalPayment = (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)) +
                      GREATEST(0, (COALESCE(w2.price, 0) + COALESCE(d2.price, 0)) - (COALESCE(w1.price, 0) + COALESCE(d1.price, 0)))  -- Corrected column name
WHERE p.order_id = 1;
